# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional modern Supabase key name; takes precedence over the legacy anon key variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable-your-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth is configured in Supabase Dashboard > Authentication > Providers > Google.

# Code Execution Service
EXECUTION_API_URL=http://localhost:9000
EXECUTION_API_KEY=your-execution-api-key

# Compiler runtime (Judge0 CE supports every language returned by /languages).
# The public CE host can be used for local development; configure your own host for production.
JUDGE0_API_URL=https://ce.judge0.com
# Optional, only when using Judge0 through RapidAPI.
JUDGE0_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PSGCompile


